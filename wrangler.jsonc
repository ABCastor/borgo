// Borgo on Cloudflare: a Worker that serves dist/ (npm run build) as static assets, with no code of its own,
// at borgo.abcastor.com. Deploy with npm run deploy.
{
  "name": "borgo",
  "compatibility_date": "2026-11-01",
  // One address for search engines and links: the custom domain only, no workers.dev or preview copies.
  "routes": [{ "pattern": "borgo.abcastor.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // /cities answers from /cities/index.html and redirects to /cities/, the canonical form of every page.
    "html_handling": "auto-trailing-slash",
    // The app routes by #fragment, so an unknown path is a real 404: dist/404.html with status 404, never the app
    // page answering 200 for addresses that do not exist.
    // The host sends .md as text/markdown and .txt as text/plain, both UTF-8, and .json as application/json.
    "not_found_handling": "404-page"
  }
}
