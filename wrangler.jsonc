// Borgo on Cloudflare: a Worker that serves dist/ (npm run build) as static assets at borgo.abcastor.com. Its small
// script (src/site/worker.ts) runs first on every page and API request: http moves to https, the host's clean-address redirects
// become permanent, and the community inbox answers /api/community/. Deploy with npm run deploy.
{
  "name": "borgo",
  "main": "src/site/worker.ts",
  "compatibility_date": "2026-11-01",
  // One address for search engines and links: the custom domain only, no workers.dev or preview copies.
  "routes": [{ "pattern": "borgo.abcastor.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Figures people add themselves (src/site/community-api.ts); tables in migrations/, applied with
  // npx wrangler d1 migrations apply borgo-community --remote.
  "d1_databases": [{ "binding": "COMMUNITY", "database_name": "borgo-community", "database_id": "0f20fdba-d1ad-43de-8feb-440ae9c55b46", "migrations_dir": "migrations" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker answers pages and the API first; the app's own files (script, styles, fonts, favicon, data) come
    // straight from the static host, so the script costs them nothing. dist/_headers keeps the data open to any origin.
    "run_worker_first": ["/*", "!/app.js", "!/app.css", "!/favicon.svg", "!/fonts/*", "!/data/*"],
    // /cities answers from /cities/index.html and redirects to /cities/, the canonical form of every page.
    "html_handling": "auto-trailing-slash",
    // The app routes by #fragment, so an unknown path is a real 404: dist/404.html with status 404, never the app
    // page answering 200 for addresses that do not exist.
    // The host sends .md as text/markdown and .txt as text/plain, both UTF-8, and .json as application/json.
    "not_found_handling": "404-page"
  }
}
