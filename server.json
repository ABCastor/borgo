{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ABCastor/borgo",
  "title": "Borgo",
  "description": "Compare cities to live in on open, sourced data: take-home pay, rent, visas, climate, safety.",
  "websiteUrl": "https://borgo.abcastor.com",
  "icons": [
    { "src": "https://borgo.abcastor.com/icon-512.png", "mimeType": "image/png", "sizes": ["512x512"] }
  ],
  "repository": {
    "url": "https://github.com/ABCastor/borgo",
    "source": "github"
  },
  "version": "0.5.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@abcastor/borgo",
      "version": "0.5.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
